  draft action Resume;
  draft determine action Prepare;


}

define behavior for ZSDi30_TRAVEL //alias <alias_name>
persistent table zsd_travell
lock dependent by _strv
authorization dependent by _strv
draft table zsd30_dft_trv
etag master LocalLastChangedAt
{
  update;
  delete;
  field ( readonly ) TravelId; //, AgencyId, CustomerId;
  field ( readonly ) SingletonEntry;
  association _strv { with draft; }

  mapping for zsd_travell
    {
      TravelId           = travel_id;
      AgencyId           = agency_id;
      CustomerId         = customer_id;
      BeginDate          = begin_date;
      EndDate            = end_date;
      BookingFee         = booking_fee;
      TotalPrice         = total_price;
      CurrencyCode       = currency_code;
      Description        = description;
      OverallStatus      = overall_status;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LastChangedBy      = last_changed_by;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }

}