with unmanaged save
draft table zsd30_dft_trv_s1
//persistent table t002
lock master
total etag maxlastchangedat
authorization master ( instance )
//etag master <field_name>
{
  //  create ( authorization : global );
  //  update;
  //  delete;
  field ( readonly ) SingletonEntry;
  association _trv { create; with draft; }

  draft action Edit;
