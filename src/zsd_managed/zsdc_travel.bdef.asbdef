projection;
strict ( 2 );
use draft;

define behavior for zsdc_travel //alias <alias_name>
use etag
{
  use create;
  use update;
  use delete;

  use association _booking { create; with draft; }
  use action accept;  // yeh ideally dusre projection view me hoga.
  use action default;
  use action copy;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}

define behavior for zsdc_book //alias <alias_name>
use etag
{
  use update;
  use delete;

  use association _travel { with draft; }
  use association _booksupp { create;  with draft; }
}

define behavior for zsdc_booksuppl //alias <alias_name>
use etag
{
  use update;
  use delete;

  use association _travel { with draft; }
  use association _book { with draft; }
}